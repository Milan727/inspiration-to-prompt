{
  "manifest_version": 3,
  "name": "Lookshot - Put Yourself in Any Photo",
  "version": "1.0.0",
  "description": "See a look you love? Turn any Pinterest or web photo into a ready-to-send ChatGPT or Gemini prompt, with you in it.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.pinterest.com/*",
    "*://*.pinterest.ca/*",
    "*://*.pinterest.co.uk/*",
    "*://*.pinterest.com.au/*",
    "*://*.pinterest.co.in/*",
    "*://*.pinterest.de/*",
    "*://*.pinterest.fr/*",
    "*://*.pinterest.es/*",
    "*://*.pinterest.it/*",
    "*://*.pinterest.com.mx/*",
    "*://*.pinterest.jp/*",
    "*://*.pinterest.ie/*",
    "*://*.pinterest.nz/*",
    "*://*.pinimg.com/*",
    "*://chatgpt.com/*",
    "*://*.chatgpt.com/*",
    "*://gemini.google.com/*",
    "*://*.gemini.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/serviceWorker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Open Lookshot"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.co.in/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.jp/*",
        "*://*.pinterest.ie/*",
        "*://*.pinterest.nz/*"
      ],
      "js": [
        "src/content/pinterestDetector.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://*.gemini.google.com/*"
      ],
      "js": [
        "src/content/llmInjector.ts"
      ],
      "run_at": "document_end"
    }
  ]
}
